PageButton < Button
  size: 30 18
  margin: 1


ContainerWindow < MiniWindow
  height: 150
  // Era a unica janela de bag sem persistencia: posicao, altura e estado
  // minimizado se perdiam a cada reabertura. UIMiniWindow guarda isso por
  // personagem em CharMiniWindows, mas so quando save esta ligado.
  &save: true

  UIItem
    id: containerItemWidget
    virtual: true
    size: 16 16
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    margin-left: 4

  UIButton
    id: upButton
    anchors.top: lockButton.top
    anchors.right: lockButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 37 0 14 14

    $hover:
      image-clip: 37 14 14 14

    $pressed:
      image-clip: 37 28 14 14

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: miniwindowTopBar.bottom
    height: 20
    margin: 2 3 0 3
    background: #00000066
    visible: false

    Label
      id: pageLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text-auto-resize: true

    PageButton
      id: prevPageButton
      text: <
      anchors.top: parent.top
      anchors.left: parent.left

    PageButton
      id: nextPageButton
      text: >
      anchors.top: parent.top
      anchors.right: parent.right

  MiniWindowContents
    padding-right: 0
    layout:
      type: grid
      cell-size: 32 32
      flow: true

// Tira de bags abertas: um botao por container, para alternar entre eles
// sem espalhar janelas pela tela.
BagTabButton < UIItem
  size: 34 34
  virtual: true
  border-width: 2
  border-color: #2a2a2e

  $hover !checked:
    border-color: #3d3d44

  $checked:
    border-color: #ff7a18
    background-color: #241a10

BagBarWindow < MiniWindow
  id: bagBarWindow
  text: Bags
  height: 60
  &save: true

  MiniWindowContents
    UIWidget
      id: bagBar
      anchors.fill: parent
      layout:
        type: grid
        cell-size: 34 34
        cell-spacing: 4
        flow: true
