Panel
  margin-top: -8
  OptionCheckBox
    id: classicControl
    text: Controle Clássico

  OptionCheckBox
    id: autoChaseOverride
    text: Permitir substituição de perseguição automática

  OptionCheckBox
    id: moveStack
    text: Mover stacks diretamente

  OptionCheckBox
    id: movePokemon
    text: Perguntar antes de derrubar uma pokébola

  OptionCheckBox
    id: showLeftPanel
    text: Barra lateral esquerda

  OptionCheckBox
    id: showLeftExtraPanel
    text: Segunda barra a esquerda

  OptionCheckBox
    id: showRightPanel
    text: Barra lateral direita

  OptionCheckBox
    id: showRightExtraPanel
    text: Segunda barra a direita

  OptionCheckBox
    id: smoothWalk
    text: Movimento fluido
    tooltip: Remove a espera de 250 ms apos um passo recusado ou um clique. O ritmo dos passos continua o mesmo.

  OptionCheckBox
    id: wasdWalking
    text: Andar com WASD
    tooltip: W A S D anda, Q E Z C faz as diagonais. Toque Enter para abrir o chat.

  OptionCheckBox
    id: smartWalk
    text: Ativar a caminhada inteligente
    tooltip: Detectará quando usar o passo diagonal com base nas teclas\nque você está pressionando

  OptionCheckBox
    id: showMoveBar
    text: Mostrar Barra de Ataques

  OptionCheckBox
    id: showItemMove
    text: Mostrar no cursor o item quando movido

  OptionCheckBox
    id: displayNames
    text: Exibir nomes de criaturas

  OptionCheckBox
    id: displayHealth
    text: Exibir barras de vida das criaturas

  OptionCheckBox
    id: displayText
    text: Exibir mensagens de texto

  OptionCheckBox
    id: disableColors
    text: Desativar cores do nome do pokemon

  OptionCheckBox
    id: shopQuestion
    text: Não perguntar ao comprar no Shop

  OptionCheckBox
    id: hideActionBar
    text: Exibir a Action Bar

  OptionCheckBox
    id: emblemas
    tooltip: Emblemas como: VIP, Level 666, Etc.
    text: Não exibir emblemas