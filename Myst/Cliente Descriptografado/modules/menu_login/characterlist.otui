// O estilo Creature padrao (data/styles/10-creatures.otui) traz
// image-source: /images/ui/panel_flat -- era esse painel que aparecia como
// um quadrado escuro atras do personagem. Herdando direto de UICreature
// nao ha imagem nenhuma por baixo.
CardCreature < UICreature
  creature-center: true
  fixed-creature-size: true
  phantom: true

// Cartao de personagem: retrato, nome, level e mundo.
// Substitui a linha de lista antiga -- a tela agora e uma fileira
// horizontal de cartoes, como na referencia do PXG.
CharacterWidget < UIWidget
  size: 152 198
  background-color: #14141600
  border-width: 2
  border-color: #2a2a2e
  focusable: true

  $focus:
    background-color: #1f1f22
    border-color: #ff7a18

  $hover !focus:
    border-color: #3d3d44

  // Area do retrato. Sem cor propria: com um tom diferente do cartao ela
  // aparecia como um quadrado recortado atras do personagem. Serve so de
  // referencia de ancoragem.
  UIWidget
    id: portraitBg
    height: 116
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    phantom: true

  CardCreature
    id: outfitCreatureBox
    size: 80 80
    anchors.centerIn: portraitBg

  // Estrela de VIP, no canto do retrato.
  Label
    id: mainCharacter
    text: *
    font: sans-bold-16px
    color: #ff7a18
    text-auto-resize: true
    visible: false
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 8
    phantom: true

  Label
    id: name
    font: sans-bold-16px
    color: #f5f5f6
    text-align: center
    text-wrap: true
    height: 34
    anchors.top: portraitBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 6 4 0 4
    phantom: true

  Label
    id: level
    font: verdana-11px-antialised
    color: #ff7a18
    text-align: center
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    phantom: true

  Label
    id: worldName
    font: verdana-11px-antialised
    color: #8a8a92
    text-align: center
    text-auto-resize: true
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 8
    phantom: true

  // Mantidos por compatibilidade com characterlist.lua, que os procura
  // por id quando GameEnterGameShowAppearance esta ligada.
  Label
    id: vocation
    visible: false

  Label
    id: statusDailyReward
    visible: false

  Label
    id: statusHidden
    visible: false

// Slot do time, abaixo dos cartoes. Um por pokemon da mochila.
PokeTeamSlot < UIWidget
  size: 62 62
  border-width: 1
  border-color: #2a2a2e

  CardCreature
    id: pokeCreature
    size: 52 52
    anchors.centerIn: parent
MainWindow
  id: charactersWindow
  !text: tr('Selecionar Personagem')
  visible: false
  size: 700 470
  @onEnter: doLogin()
  @onEscape: hide(true)
  @onSetup: |
    -- Personagens ficam lado a lado agora, entao as setas andam na
    -- horizontal.
    g_keyboard.bindKeyPress('Left', function() self:getChildById('characters'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Right', function() self:getChildById('characters'):focusNextChild(KeyboardFocusReason) end, self)

  ScrollablePanel
    id: characters
    height: 206
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 12
    margin-right: 12
    padding: 2
    focusable: false
    horizontal-scrollbar: characterListScrollBar
    auto-focus: first
    layout:
      type: grid
      cell-size: 152 198
      cell-spacing: 8
      flow: false

  HorizontalScrollBar
    id: characterListScrollBar
    anchors.top: characters.bottom
    anchors.left: characters.left
    anchors.right: characters.right
    margin-top: 2
    step: 80
    pixels-scroll: true

  Label
    id: teamCaption
    !text: tr('Time')
    font: verdana-11px-antialised
    color: #8a8a92
    text-auto-resize: true
    anchors.top: characterListScrollBar.bottom
    anchors.left: characters.left
    margin-top: 10

  UIWidget
    id: teamRow
    // 6 x 62 + 5 x 8 de espacamento
    size: 412 62
    anchors.top: teamCaption.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    layout:
      type: horizontalBox
      spacing: 8

  Label
    id: accountStatusIcon
    size: 12 12
    anchors.bottom: buttonCancel.top
    anchors.left: characters.left
    margin-bottom: 10

  Label
    id: accountStatusLabel
    !text: tr('Conta Gratis')
    font: verdana-11px-antialised
    color: #8a8a92
    text-auto-resize: true
    anchors.verticalCenter: accountStatusIcon.verticalCenter
    anchors.left: accountStatusIcon.right
    margin-left: 6

  UIButton
    id: buttonCancel
    !text: tr('Voltar')
    font: verdana-11px-antialised
    color: #f5f5f6
    size: 110 40
    anchors.bottom: parent.bottom
    anchors.left: characters.left
    margin-bottom: 10
    background-color: #1f1f22
    @onClick: hide(true)

    $hover:
      background-color: #2a2a2e

  UIButton
    id: buttonOk
    !text: tr('JOGAR!')
    font: sans-bold-16px
    color: #0a0a0b
    height: 40
    anchors.bottom: parent.bottom
    anchors.left: buttonCancel.right
    anchors.right: characters.right
    margin-bottom: 10
    margin-left: 10
    background-color: #ff7a18
    @onClick: doLogin()

    $hover:
      background-color: #ffa24d

    $pressed:
      background-color: #e0680f
