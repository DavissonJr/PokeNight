// Cartao de personagem: retrato, nome, level e mundo.
// Substitui a linha de lista antiga -- a tela agora e uma fileira
// horizontal de cartoes, como na referencia do PXG.
CharacterWidget < UIWidget
  size: 152 198
  background-color: #14141600
  border-width: 2
  border-color: #2a2a2e
  focusable: true

  $focus:
    background-color: #1f1f22
    border-color: #ff7a18

  $hover !focus:
    border-color: #3d3d44

  // Fundo do retrato, para o outfit nao flutuar no vazio.
  UIWidget
    id: portraitBg
    height: 116
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 2 0 2
    background-color: #0e0e10
    phantom: true

  Creature
    id: outfitCreatureBox
    size: 80 80
    anchors.centerIn: portraitBg
    creature-center: true
    fixed-creature-size: true
    phantom: true

  // Estrela de VIP, no canto do retrato.
  Label
    id: mainCharacter
    text: *
    font: sans-bold-16px
    color: #ff7a18
    text-auto-resize: true
    visible: false
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 8
    phantom: true

  Label
    id: name
    font: sans-bold-16px
    color: #f5f5f6
    text-align: center
    text-wrap: true
    height: 34
    anchors.top: portraitBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 6 4 0 4
    phantom: true

  Label
    id: level
    font: verdana-11px-antialised
    color: #ff7a18
    text-align: center
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    phantom: true

  Label
    id: worldName
    font: verdana-11px-antialised
    color: #8a8a92
    text-align: center
    text-auto-resize: true
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 8
    phantom: true

  // Mantidos por compatibilidade com characterlist.lua, que os procura
  // por id quando GameEnterGameShowAppearance esta ligada.
  Label
    id: vocation
    visible: false

  Label
    id: statusDailyReward
    visible: false

  Label
    id: statusHidden
    visible: false

// Slot do time, abaixo dos cartoes. Um por pokemon da mochila.
PokeTeamSlot < UIWidget
  size: 62 62
  background-color: #0e0e10
  border-width: 1
  border-color: #2a2a2e

  Creature
    id: pokeCreature
    size: 52 52
    anchors.centerIn: parent
    creature-center: true
    fixed-creature-size: true
    phantom: true

MainWindow
  id: charactersWindow
  !text: tr('Character List')
  visible: false
  @onEnter: doLogin()
  @onEscape: hide(true)
  @onSetup: |
    -- Setas passam a andar na horizontal: os personagens agora ficam lado
    -- a lado, nao empilhados.
    g_keyboard.bindKeyPress('Left', function() self:getChildById('characters'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Right', function() self:getChildById('characters'):focusNextChild(KeyboardFocusReason) end, self)
    -- Tamanho fixo: a tela nova nao depende mais das features de versao,
    -- porque os dados (level, outfit, time) vem da API e nao do protocolo.
    self:setSize({width = 700, height = 470})

  UIButton
    id: titleTab
    size: 212 28
    image-source: /images/ui/titleTab.png
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -31
    margin-left: 28

  Label
    id: titleTabLabel
    text-auto-resize: true
    text: Personagens
    color: #e0680f
    font: sans-bold-16px
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -29
    margin-left: 87

  ScrollablePanel
    id: characters
    height: 206
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 10 14 0 14
    padding: 2
    focusable: false
    horizontal-scrollbar: characterListScrollBar
    auto-focus: first
    layout:
      type: grid
      cell-size: 152 198
      cell-spacing: 8
      flow: false

  HorizontalScrollBar
    id: characterListScrollBar
    anchors.top: characters.bottom
    anchors.left: characters.left
    anchors.right: characters.right
    margin-top: 2
    step: 80
    pixels-scroll: true

  Label
    id: teamCaption
    !text: tr('Time')
    font: verdana-11px-antialised
    color: #8a8a92
    text-auto-resize: true
    anchors.top: characterListScrollBar.bottom
    anchors.left: parent.left
    margin-top: 12
    margin-left: 16

  UIWidget
    id: teamRow
    height: 62
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    width: 410
    layout:
      type: horizontalBox
      spacing: 8

  Button
    id: playButton
    !text: tr('JOGAR!')
    font: sans-bold-16px
    color: #0a0a0b
    background-color: #ff7a18
    height: 44
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 0 60 16 60
    @onClick: doLogin()

    $hover:
      background-color: #ffa24d

    $pressed:
      background-color: #e0680f


  FlatLabel
    width: 250
    anchors.left: parent.left
    anchors.top: characters.top
    !text: tr('Character') .. ''
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  FlatLabel
    width: 50
    anchors.left: parent.left
    anchors.top: characters.top
    margin-left: 250
    !text: tr('Status') .. ''
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  FlatLabel
    width: 50
    anchors.left: parent.left
    anchors.top: characters.top
    margin-left: 300
    !text: tr('Level') .. ''
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  FlatLabel
    width: 150
    anchors.left: parent.left
    anchors.top: characters.top
    margin-left: 350
    !text: tr('Vocation') .. ''
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  FlatLabel
    width: 201
    anchors.right: characters.right
    anchors.top: characters.top
    !text: tr('World') .. ''
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  VerticalScrollBar
    id: characterListScrollBar
    anchors.top: parent.top
    anchors.bottom: accountStatusCaption.top
    anchors.right: parent.right
    margin-bottom: -15
    margin-right: -10
    step: 14
    pixels-scroll: true
    visible: false

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 249
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 299
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 349
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 499
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: accountStatusCaption
    !text: tr('Account Status') .. ':'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    visible: false
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(5)
      else
        self:setMarginBottom(1)
      end

  Label
    id: accountStatusIcon
    size: 22 20
    anchors.left: parent.left
    anchors.bottom: next.bottom
    image-source: /images/game/entergame/premium
    image-clip: 0 0 22 20
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: accountStatusLabel
    !text: tr('Conta Grátis')
    anchors.left: parent.left
    text-auto-resize: true
    margin-left: 65
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(15)
        self:setPaddingBottom(2)
        self:setTextOffset({x = 25, y = 0})
        self:addAnchor(AnchorBottom, 'next', AnchorBottom)
      else
        self:setMarginBottom(5)
        self:addAnchor(AnchorRight, 'parent', AnchorRight)
        self:addAnchor(AnchorBottom, 'separator', AnchorTop)
      end

    $on:
      color: #FF0000

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 10

  //CheckBox
  //  id: charAutoLoginBox
  //  !text: tr('Auto login')
  //  !tooltip: tr('Auto login selected character on next charlist load')
  //  anchors.left: parent.left
  //  anchors.right: parent.right
  //  anchors.bottom: next.top
  //  margin-bottom: 6
  //  margin-left: 18
  //  margin-right: 18

  UIButton
    id: buttonOk
    !text: tr('Entrar')
    size: 104 26
    image-source: images/button.png
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 20
    @onClick: doLogin()

    $hover:
      image-source: images/button_hover.png

  UIButton
    id: buttonCancel
    !text: tr('Voltar')
    size: 104 26
    image-source: images/button.png
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: hide(true)
    margin-right: 25

    $hover:
      image-source: images/button_hover.png
