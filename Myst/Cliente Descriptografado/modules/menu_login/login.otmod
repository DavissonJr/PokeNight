Module
  name: menu_login
  description: Manages enter game and character list windows
  author: edubart
  website: www.otclient.info

  load-later:
    - game_things
    - game_features

  @onLoad: |
    dofile 'login'
    dofile 'characterlist'
    -- Precisa vir depois de login.lua: estende a tabela EnterGame dele.
    dofile 'pko_register'
    -- Tabela nome de pokemon -> outfit (design/gen_poke_looktypes.py) e os
    -- detalhes que o protocolo 8.54 nao manda. Depois de characterlist.
    dofile 'poke_looktypes'
    dofile 'charinfo'
    EnterGame.init()
    init()
    EnterGame.refreshOnline()

  @onUnload: |
    EnterGame.terminate()
    terminate()
