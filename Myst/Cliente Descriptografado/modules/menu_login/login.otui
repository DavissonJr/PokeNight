// ---------------------------------------------------------------------------
// Tela de entrada do PokeOrigin.
//
// Layout em cartao centralizado, duas colunas: marca a esquerda, formulario
// a direita com abas Entrar / Criar conta. As pecas visuais vivem em pko/ e
// sao locais deste modulo -- o tema global do cliente segue intocado.
//
// IDs preservados por compatibilidade com login.lua: accountNameTextEdit,
// accountPasswordTextEdit, stayLoggedBox, entrarAutomac, lembrarSenha,
// serverHostTextEdit, serverPortTextEdit, clientComboBox,
// authenticatorTokenTextEdit. Os quatro ultimos ficam ocultos: o servidor e
// fixo (setUniqueServer), entao nao ha o que o jogador escolher.
// ---------------------------------------------------------------------------

PkoField < TextEdit
  height: 34
  font: verdana-11px-antialised
  color: #f5f5f6
  image-source: pko/field.png
  image-border: 5
  padding-left: 10
  padding-right: 10
  selection-color: #0a0a0b
  selection-background-color: #ff7a18

PkoButton < UIButton
  height: 38
  font: sans-bold-16px
  color: #f5f5f6
  image-source: pko/btn.png
  image-border: 4
  image-clip: 0 0 20 20

  $hover !disabled:
    image-clip: 0 20 20 20
    color: #ff7a18

  $pressed:
    image-clip: 0 40 20 20

  $disabled:
    color: #5a5a62

// Herda de UIButton, nao de PkoButton: o botao de acao principal e um
// bloco laranja solido, entao nao pode carregar a imagem 9-slice do outro.
PkoPrimary < UIButton
  height: 38
  color: #0a0a0b
  font: sans-bold-16px
  background-color: #ff7a18

  $hover !disabled:
    background-color: #ffa24d
    color: #0a0a0b

  $pressed:
    background-color: #e06a10

  $disabled:
    background-color: #3a2a1c
    color: #7a6a5c

PkoTab < UIButton
  height: 34
  width: 130
  font: sans-bold-16px
  color: #8a8a92
  image-source: pko/tab.png
  image-border: 4
  image-clip: 0 0 20 20

  $hover !checked:
    image-clip: 0 20 20 20
    color: #f5f5f6

  $checked:
    image-clip: 0 40 20 20
    color: #ff7a18

PkoHint < Label
  font: verdana-11px-antialised
  color: #8a8a92
  text-auto-resize: true

PkoStatus < Label
  font: verdana-11px-antialised
  color: #8a8a92
  text-auto-resize: true
  text-wrap: true

EnterGameWindow < UIWidget
  image-source: pko/login_bg.png
  image-smooth: true
  focusable: true

EnterGameWindow
  id: enterGame
  anchors.fill: parent

  // ---- cartao central ----------------------------------------------------
  UIWidget
    id: card
    size: 860 470
    anchors.centerIn: parent
    image-source: pko/card.png
    image-border: 6

    // ---- coluna da marca -------------------------------------------------
    UIWidget
      id: brandCol
      width: 330
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin: 1 0 1 1
      background-color: #0e0e10

      UIWidget
        id: brandMark
        size: 108 108
        image-source: pko/mark_128.png
        image-smooth: true
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 64

      UIWidget
        id: brandWord
        size: 300 78
        image-source: pko/wordmark.png
        image-smooth: true
        anchors.top: prev.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 18

      PkoHint
        id: brandTag
        text: O seu mundo Pokemon comeca aqui.
        anchors.top: prev.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10

      PkoHint
        id: onlineCount
        text: conectando...
        color: #ff7a18
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-bottom: 28

    // ---- coluna do formulario -------------------------------------------
    UIWidget
      id: formCol
      anchors.left: brandCol.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin: 1 1 1 0

      PkoTab
        id: tabLogin
        text: Entrar
        checked: true
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 26
        margin-left: 34
        @onClick: EnterGame.switchTab('login')

      PkoTab
        id: tabRegister
        text: Criar conta
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 8
        @onClick: EnterGame.switchTab('register')

      // ================= PAINEL: ENTRAR =================================
      UIWidget
        id: loginPanel
        anchors.top: tabLogin.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 22 34 20 34

        PkoHint
          id: lblAccount
          text: Conta
          anchors.top: parent.top
          anchors.left: parent.left

        PkoField
          id: accountNameTextEdit
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6

        PkoHint
          id: lblPassword
          text: Senha
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 14

        PkoField
          id: accountPasswordTextEdit
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          text-hidden: true

        CheckBox
          id: lembrarSenha
          text-auto-resize: true
          width: 260
          text: Lembrar meus dados
          font: verdana-11px-antialised
          color: #8a8a92
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 18
          @onCheckChange: self:getParent():getChildById('entrarAutomac'):setEnabled(self:isChecked())

        CheckBox
          id: entrarAutomac
          text-auto-resize: true
          width: 260
          text: Entrar automaticamente
          font: verdana-11px-antialised
          color: #8a8a92
          enabled: false
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 8

        PkoStatus
          id: loginStatus
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 14

        PkoPrimary
          id: btnLogin
          text: ENTRAR NO JOGO
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 6
          @onClick: EnterGame.doLogin()

      // ================= PAINEL: CRIAR CONTA ============================
      UIWidget
        id: registerPanel
        visible: false
        anchors.top: tabLogin.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 22 34 20 34

        // ---- etapa 1: dados da conta -----------------------------------
        UIWidget
          id: step1
          anchors.fill: parent

          PkoHint
            id: rLblAccount
            text: Nome da conta
            anchors.top: parent.top
            anchors.left: parent.left

          PkoField
            id: regAccount
            anchors.top: prev.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 6
            max-length: 24
            @onTextChange: EnterGame.onRegAccountChange()

          PkoHint
            id: rLblPass
            text: Senha
            anchors.top: prev.bottom
            anchors.left: parent.left
            margin-top: 12

          PkoField
            id: regPassword
            anchors.top: prev.bottom
            anchors.left: parent.left
            anchors.right: parent.horizontalCenter
            margin-top: 6
            margin-right: 6
            text-hidden: true

          PkoHint
            id: rLblPass2
            text: Repetir senha
            anchors.top: rLblPass.top
            anchors.left: parent.horizontalCenter
            margin-left: 6

          PkoField
            id: regPassword2
            anchors.top: regPassword.top
            anchors.left: parent.horizontalCenter
            anchors.right: parent.right
            margin-left: 6
            text-hidden: true

          PkoHint
            id: rLblEmail
            text: E-mail (opcional, para recuperar a conta)
            anchors.top: regPassword.bottom
            anchors.left: parent.left
            margin-top: 12

          PkoField
            id: regEmail
            anchors.top: prev.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 6

          PkoStatus
            id: regStatus
            anchors.top: prev.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 12

          PkoPrimary
            id: btnRegNext
            text: CONTINUAR
            anchors.bottom: parent.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-bottom: 6
            @onClick: EnterGame.doRegisterStep1()

        // ---- etapa 2: o personagem -------------------------------------
        UIWidget
          id: step2
          visible: false
          anchors.fill: parent

          PkoHint
            id: cLblTitle
            text: Sua conta esta pronta. Agora escolha seu personagem.
            color: #ff7a18
            anchors.top: parent.top
            anchors.left: parent.left

          PkoHint
            id: cLblName
            text: Nome do personagem
            anchors.top: prev.bottom
            anchors.left: parent.left
            margin-top: 16

          PkoField
            id: charName
            anchors.top: prev.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 6
            max-length: 20
            @onTextChange: EnterGame.onCharNameChange()

          PkoHint
            id: cLblSex
            text: Aparencia
            anchors.top: prev.bottom
            anchors.left: parent.left
            margin-top: 14

          PkoButton
            id: sexMale
            text: Menino
            width: 150
            anchors.top: prev.bottom
            anchors.left: parent.left
            margin-top: 6
            @onClick: EnterGame.setSex('male')

          PkoButton
            id: sexFemale
            text: Menina
            width: 150
            anchors.top: prev.top
            anchors.left: prev.right
            margin-left: 8
            @onClick: EnterGame.setSex('female')

          PkoStatus
            id: charStatus
            anchors.top: sexMale.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 14

          PkoButton
            id: btnCharBack
            text: Voltar
            width: 120
            anchors.bottom: parent.bottom
            anchors.left: parent.left
            margin-bottom: 6
            @onClick: EnterGame.backToStep1()

          PkoPrimary
            id: btnCharCreate
            text: CRIAR E ENTRAR
            anchors.bottom: parent.bottom
            anchors.left: prev.right
            anchors.right: parent.right
            margin-bottom: 6
            margin-left: 8
            @onClick: EnterGame.doCreateCharacter()

  // ---- campos herdados, mantidos ocultos ---------------------------------
  // login.lua ainda os le; o servidor e fixo, entao nao ha escolha a fazer.
  TextEdit
    id: serverHostTextEdit
    visible: false

  TextEdit
    id: serverPortTextEdit
    visible: false

  TextEdit
    id: authenticatorTokenTextEdit
    visible: false

  CheckBox
    id: stayLoggedBox
    visible: false

  ComboBox
    id: clientComboBox
    visible: false

  // Widgets da selecao de servidor. Nao aparecem na tela nova, mas
  // EnterGame.setUniqueServer() ainda os esconde por ID -- mante-los aqui
  // evita mexer naquela funcao e quebrar o login que ja funciona.
  Label
    id: serverLabel
    visible: false

  Label
    id: clientLabel
    visible: false

  Label
    id: portLabel
    visible: false

  Label
    id: serverInfoLabel
    visible: false

  UIButton
    id: serverListButton
    visible: false
