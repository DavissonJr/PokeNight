Module
  name: client_serverlist
  description: Manages a server list of previously entered servers
  author: BeniS
  website: https://github.com/edubart/otclient

  dependencies:
    - menu_login

  @onLoad: |
    dofile 'serverlist'
    dofile 'addserver'
    ServerList.init()
    AddServer.init()

  @onUnload: |
    ServerList.terminate()
    AddServer.terminate()
