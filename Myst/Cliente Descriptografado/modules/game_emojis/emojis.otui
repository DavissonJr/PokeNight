EmojisWindow < UIMiniWindow
  font: terminus-10px
  width: 192
  height: 200
  text-offset: 24 5
  text-align: topLeft
  image-border: 7
  image-border-top: 29
  image-border-bottom: 4
  focusable: false
  &minimizedHeight: 24

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 3
    size: 258 18
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    margin-right: 5
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 24 0 14 14

    $hover:
      image-clip: 24 14 14 14

    $pressed:
      image-clip: 24 12 14 14

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: -1 0 14 14
    visible: false

    $hover:
      image-clip: -1 14 14 14

    $pressed:
      image-clip: -1 28 14 14

    $on:
      image-clip: 12 0 14 14

    $on hover:
      image-clip: 12 14 14 14

    $on pressed:
      image-clip: 12 28 14 14

  UIButton
    id: lockButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 74 0 14 14

    $hover:
      image-clip: 74 14 14 14

    $pressed:
      image-clip: 74 28 14 14

    $on:
      image-clip: 86 0 14 14

    $on hover:
      image-clip: 86 29 14 14

    $on pressed:
      image-clip: 86 28 14 14

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 22
    margin-right: 3
    margin-bottom: 3
    pixels-scroll: true
    visible: false

    $!on:
      width: 0

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 48
    margin-left: 3
    margin-right: 3
    background: #ffffff88

EmojisWindow
  id: emojisWindow
  image-source: images/window
  size: 350 186
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 330
  margin-left: 198
  focusable: true
  @onEscape: modules.game_emojis.exibir()

  UIButton
    id: emojis
    size: 16 16
    image-source: images/emojis
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    margin-left: 10

  UIButton
    id: pokemons
    size: 18 16
    image-source: images/pokemons
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 3
    margin-left: 32

  UIButton
    id: symbols
    size: 18 16
    image-source: images/symbols
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    margin-left: 55

  ScrollablePanel
    id: emojisPanel
    size: 340 153
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 26
    margin-left: 4
    layout:
      type: grid
      cell-size: 30 31
      flow: true