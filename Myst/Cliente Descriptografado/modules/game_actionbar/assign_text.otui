MainWindow
  size: 250 165
  @onEscape: modules.game_actionbar.closeTextAssignWindow()
  @onEnter: modules.game_actionbar.textAssignAccept()

  UIButton
    id: titleTab
    size: 180 28
    image-source: images/titleTab.png
    color: #e0680f
    font: sans-bold-16px
    text: Editar Texto
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.centerIn: parent
    margin-top: -73
  
  Label
    id: textLabel
    text: Texto:
    text-auto-resize: true
    height: 20
    anchors.top: parent.top
    anchors.left: parent.left
  TextEdit
    id: textToSendTextEdit
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    width: 218
  FlatPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    size: 200 28
    margin-top: 5
    padding: 2
    CheckBox
      margin-top: 2
      margin-left: 2
      id: sendAutomaticallyCheckBox
      text: Enviar automaticamente
      text-offset: 22 -1
      anchors.fill: parent
      text-auto-resize: true
      @onSetup: self:setChecked(true)
  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 2
    margin-top: 10
  UIButton
    id: applyButton
    size: 106 24
    image-source: images/button.png
    text: Confirmar
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    @onClick: modules.game_actionbar.textAssignAccept()

    $hover:
      image-source: images/button_hover.png
  UIButton
    id: cancelButton
    size: 106 24
    image-source: images/button.png
    text: Cancelar
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_actionbar.closeTextAssignWindow()

    $hover:
      image-source: images/button_hover.png
