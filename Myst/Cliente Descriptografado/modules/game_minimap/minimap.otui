MinimapMain < UIWidget
  phantom: true

MinimapText < UIWidget
  focusable: true
  opacity: 0.8
  $pressed:
    opacity: 0.6
  $hover !pressed:
    opacity: 1.0

MinimapFloorUpButton < UIButton
  size: 23 25
  margin-right: 88
  margin-bottom: 3
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  image-source: /images/game/minimap/button
  icon-source: /images/game/minimap/up
  @onClick: modules.game_minimap.floorUpp(1)
  id: floorUpp

  $hover:
    image-source:  /images/game/minimap/button_hover

MinimapFloorDownButton < UIButton
  size: 23 25
  margin-right: 60
  margin-bottom: 3
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  image-source: /images/game/minimap/button
  icon-source: /images/game/minimap/down
  @onClick: modules.game_minimap.floorDownn(1)
  id: floorDownn

  $hover:
    image-source:  /images/game/minimap/button_hover

MinimapZoomInButton < UIButton
  color: #ff7a18
  text: +
  size: 23 25
  margin-right: 32
  margin-bottom: 3
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  image-source: /images/game/minimap/button
  //icon-source: /images/game/minimap/zoom_in
  @onClick: modules.game_minimap.zoomInn()
  id: zoomInn

  $hover:
    image-source:  /images/game/minimap/button_hover

MinimapZoomOutButton < UIButton
  color: #ff7a18
  text: -
  size: 23 25
  margin-right: 4
  margin-bottom: 3
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  image-source: /images/game/minimap/button
  //icon-source: /images/game/minimap/zoom_out
  @onClick: modules.game_minimap.zoomOutt()
  id: zoomOutt

  $hover:
    image-source:  /images/game/minimap/button_hover

MinimapResetButton < UIButton
  tooltip: Centro
  image-source: /images/game/minimap/button
  icon: /images/game/minimap/center
  size: 23 25
  margin-right: 143
  margin-bottom: 3
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  @onClick: modules.game_minimap.resett()
  id: resett

  $hover:
    image-source:  /images/game/minimap/button_hover

MinimapScreenButton < UIButton
  tooltip: Expandir Mapa
  image-source: /images/game/minimap/button
  icon: /images/game/minimap/expandir
  size: 23 25
  margin-right: 115
  margin-bottom: 3
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  @onClick: modules.game_minimap.toggleFullMap()
  id: screen

  $hover:
    image-source:  /images/game/minimap/button_hover

TPLabel < Label
  color: white
  font: verdana-11px-rounded
  margin-right: 4
  margin-botton: 2
  anchors.right: floorDown.left
  anchors.bottom: floorDown.bottom
  id: tptime

TPLabelText < Label
  color: white
  font: verdana-11px-rounded
  margin-right: 2
  anchors.right: tptime.left
  anchors.bottom: tptime.bottom
  opacity: 0
  id: tptext
  
Button < UIButton
  font: verdana-11px-antialised
  color: #dfdfdf
  size: 64 20
  text-offset: 0 0
  image-source: /images/ui/button_rounded
  image-color: white
  image-clip: 0 0 20 20
  image-border: 3
  padding: 5 10 5 10

  $hover !disabled:
    image-clip: 0 20 20 20
    color: white

  $pressed:
    image-clip: 0 40 20 20
    text-offset: 1 1
    color: #dfdfdf

  $disabled:
    color: #5353A3

HouseTeleportButton < UIButton
  margin-right: 4
  margin-bottom: 4
  image-source: /images/ui/button_rounded2
  image-color: white
  image-clip: 0 0 25 25
  image-border: 3
  padding: 5 10 5 10
  anchors.right: tptext.left
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/house
  id: housetp
  opacity: 0
  size: 25 25
  $hover !disabled:
    image-clip: 0 25 25 25

  $pressed:
    image-clip: 0 50 25 25
    text-offset: 1 1

MiniWindow
  id: minimapWindow
  text: Minimapa
  height: 150
  icon: /images/topbuttons/minimap
  @onClose: closeWindow()
  &save: true

  MiniWindowContents
    Minimap
      id: minimap
      anchors.fill: parent