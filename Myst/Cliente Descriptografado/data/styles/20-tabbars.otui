MoveableTabBar < UIMoveableTabBar
  size: 80 20
MoveableTabBarPanel < Panel
MoveableTabBarButton < UIButton
  size: 20 20
  image-source: /images/ui/New Piskel
  image-color: white
  image-clip: 0 0 0 0
  image-border: 8
  icon-color: white
  anchors.top: parent.top
  anchors.left: parent.left
  padding: 5

TabBar < UITabBar
  size: 80 20
  Panel
    id: buttonsPanel
    anchors.fill: parent
TabBarPanel < Panel
TabBarButton < UIButton
  size: 20 20
  image-source: /images/ui/tabbutton_square
  image-color: white
  image-clip: 0 0 20 20
  image-border: 3
  icon-color: white
  color: white
  anchors.top: parent.top
  padding: 5

  $first:
    anchors.left: parent.left

  $!first:
    anchors.left: prev.right
    margin-left: 5

  $hover !checked:
    image-clip: 0 20 20 20
    color: white

  $disabled:
    image-color: #ffffff66
    icon-color: #888888

  $checked:
    image-clip: 0 40 20 20
    color: white

  $on !checked:
    color: white

TabBarRounded < TabBar
TabBarRoundedPanel < TabBarPanel
TabBarRoundedButton < TabBarButton
  image-source: /images/ui/tabbutton_rounded

TabBarVertical < UITabBar
  width: 96
  ScrollableFlatPanel
    id: buttonsPanel
    image-source: /images/ui/panel_flat2
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: scrollBar.left
    anchors.bottom: parent.bottom
    vertical-scrollbar: scrollBar
  VerticalScrollBar
    id: scrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 16
    pixels-scroll: true
    $!on:
      width: 0
TabBarVerticalPanel < Panel
TabBarVerticalButton < UIButton
  size: 48 48
  font: sans-bold-16px
  color: white
  anchors.left: parent.left
  anchors.right: parent.right
  text-align: bottom
  icon-align: top
  icon-offset-y: 2
  icon-color: #888888
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom
    margin-top: 10
  $!hover:
    color: gray
  $hover !checked:
    color: white
    icon-color: #cccccc
  $disabled:
    icon-color: #333333
  $checked:
    icon-color: #009454
    color: #1db954
  $on !checked:
    color: white

PokedexTabBar < TabBarRounded
PokedexTabBarPanel < TabBarRoundedPanel
PokedexTabBarButton < TabBarRoundedButton
  margin-top: 5
  margin-left: 5

TabBar1Vertical < UITabBar
  width: 120
  ScrollableFlatPanel1
    id: buttonsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: scrollBar.left
    anchors.bottom: parent.bottom
    vertical-scrollbar: scrollBar
  VerticalScrollBar
    id: scrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 80
    pixels-scroll: true
    $!on:
      width: 0
TabBar1VerticalPanel < Panel
TabBar1VerticalButton < UIButton
  size: 48 57
  color: #aaaaaa
  anchors.left: parent.left
  anchors.right: parent.right
  text-align: bottom
  icon-align: top
  icon-offset-y: 10
  icon-color: #888888
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom
    margin-top: 10
  $hover !checked:
    color: white
    icon-color: #cccccc
  $disabled:
    icon-color: #333333
  $checked:
    icon-color: #ffffff
    color: #80c7f8
  $on !checked:
    color: #F55E5E

ShopTabBarVertical < UITabBar
  width: 118
  ScrollableFlatPanel
    id: buttonsPanel
    image-color: alpha
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: scrollBar.left
    anchors.bottom: parent.bottom
    vertical-scrollbar: scrollBar
  VerticalScrollBar
    id: scrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 16
    pixels-scroll: true
    $!on:
      width: 0
ShopTabBarVerticalPanel < Panel
ShopTabBarVerticalButton < UIButton
  height: 61
  anchors.left: parent.left
  anchors.right: parent.right
  icon-clip: 0 0 42 61
  icon-align: right
  icon-color: white
  margin-right: 0
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom
    margin-top: 5
  $hover !checked:
    icon-clip: 42 0 111 61
    margin-right: 8
  $checked:
    icon-clip: 42 0 111 61
    margin-right: 8
  $pressed !checked:
    icon-color: #757575