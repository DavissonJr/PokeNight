MiniWindowContents < ScrollablePanel
  id: contentsPanel
  anchors.fill: parent
  anchors.right: miniwindowScrollBar.left
  margin-left: 1
  margin-bottom: 3
  margin-top: 22
  margin-right: 1
  vertical-scrollbar: miniwindowScrollBar

BorderlessGameWindow < UIWindow
  focusable: false
  margin: 2

MiniQtScrollableWindow < UIMiniWindow
  icon-rect: 4 4 16 16
  width: 192
  height: 200
  image-source: /images/ui/window
  image-border: 4
  image-border-top: 16
  image-border-bottom: 4
  focusable: false
  &minimizedHeight: 17

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 2
    size: 258 18
    phantom: true

  VerticalQtScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 16
    margin-right: 3
    margin-bottom: 3
    pixels-scroll: true

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    anchors.right: miniwindowScrollBar.left
    margin-top: 25
    margin-left: 10
    margin-bottom: 5
    margin-right: 10
    vertical-scrollbar: miniwindowScrollBar

MiniQtWindow < UIMiniWindow
  icon-rect: 4 4 16 16
  width: 192
  height: 200
  image-source: /images/ui/window
  image-border: 4
  image-border-top: 16
  image-border-bottom: 4
  &minimizedHeight: 17
  draggable: true

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 2
    size: 258 18
    phantom: true

PhantomMiniWindow < UIMiniWindow
  draggable: true
  phantom: false
  focusable: false
  &moveOnlyToMain: true

  UIWidget
    image-source: /images/ui/background
    image-repeated: true
    anchors.fill: parent
    margin-left: 3
    margin-right: 3
    phantom: true

  UIWidget
    id: miniwindowTopBar
    phantom: true

  UIButton
    id: closeButton
    phantom: true
