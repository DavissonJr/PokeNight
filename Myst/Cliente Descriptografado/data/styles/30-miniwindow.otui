MiniWindow < UIMiniWindow
  font: terminus-10px
  color: #ff7a18
  icon-rect: 4 4 16 16
  width: 215
  height: 200
  text-offset: 24 5
  text-align: topLeft
  image-source: /images/ui/miniwindow
  image-border: 4
  image-border-top: 23
  image-border-bottom: 4
  focusable: false
  &minimizedHeight: 24

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 3
    size: 258 18
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    margin-right: 5
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 24 0 14 14

    $hover:
      image-clip: 24 14 14 14

    $pressed:
      image-clip: 24 12 14 14

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: -0 0 14 14

    $hover:
      image-clip: -1 14 14 14

    $pressed:
      image-clip: -1 28 14 14

    $on:
      image-clip: 12 0 14 14

    $on hover:
      image-clip: 12 14 14 14

    $on pressed:
      image-clip: 12 28 14 14

  UIButton
    id: lockButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 74 0 14 14

    $hover:
      image-clip: 74 14 14 14

    $pressed:
      image-clip: 74 28 14 14

    $on:
      image-clip: 86 0 14 14

    $on hover:
      image-clip: 86 29 14 14

    $on pressed:
      image-clip: 86 28 14 14

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 22
    margin-right: 3
    margin-bottom: 3
    pixels-scroll: true

    $!on:
      width: 0

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 48
    margin-left: 3
    margin-right: 3
    background: #ffffff88

NewMiniWindow < UIMiniWindow
  width: 192
  height: 200
  focusable: false
  &minimizedHeight: 30

  UIWidget
    id: background
    image-source: /images/ui/newminiwindow2
    image-border: 4
    image-border-top: 29
    image-border-bottom: 4
    anchors.fill: parent
    phantom: true

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 3
    size: 194 27
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    margin-right: 3
    size: 24 24
    image-source: /images/ui/newminiwindow_buttons
    image-clip: 0 0 24 24
    opacity: 0.7

    $hover:
      image-clip: 24 0 24 24
      opacity: 1.0

    $pressed:
      image-clip: 24 0 24 24
      opacity: 0.8

  UIButton
    id: minimizeButton
    anchors.top: prev.top
    anchors.right: prev.left
    margin-right: 2
    size: 24 24
    image-source: /images/ui/newminiwindow_buttons
    image-clip: 0 24 24 24
    opacity: 0.7

    $hover:
      opacity: 1.0

    $pressed:
      opacity: 0.6

    $on:
      image-clip: 24 24 24 24

  UIWidget
    id: iconBackground
    size: 30 30
    image-source: /images/ui/miniwindowIconBackground
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -1
    margin-left: -5
    phantom: true

  UIWidget
    id: icon
    size: 24 24
    anchors.horizontalCenter: iconBackground.horizontalCenter
    anchors.verticalCenter: iconBackground.verticalCenter
    phantom: true

  UILabel
    id: text
    font: lucida-11px-rounded
    color: #ffd9b8
    height: 16
    anchors.verticalCenter: iconBackground.verticalCenter
    anchors.left: iconBackground.right
    anchors.right: lockButton.left
    margin-left: 2
    phantom: true
    text-align: left

  GODzruVerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 40
    margin-right: 2
    margin-bottom: 3
    pixels-scroll: true

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 48
    margin-left: 3
    margin-right: 3
    background: #ffffff88

