OptionPanel  
  OptionCheckBox
    id: vsync
    text: Habilitar sincronização vertical
    tooltip: Limita FPS (geralmente a 60)

  OptionCheckBox
    id: showFps
    text: Mostrar framerate

  OptionCheckBox
    id: enableLights
    text: Ativar luzes

  OptionCheckBox
    id: antialiasing
    text: Antialiasing

  Label
    margin-top: 12
    id: optimizationLevelLabel
    text: Nível de Otimização:
    
  ComboBox
    id: optimizationLevel
    margin-top: 3
    margin-right: 2
    margin-left: 2
    @onOptionChange: modules.client_options.setOption(self:getId(), self.currentIndex)
    @onSetup: |
      self:addOption("Automatic")
      self:addOption("None")
      self:addOption("Low")
      self:addOption("Medium")
      self:addOption("High")
      self:addOption("Maximum")

  Label
    id: ambientLightLabel
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('ambientLight')
      self:setText(tr('Luz ambiente: %s%%', value))

  OptionScrollbar
    id: ambientLight
    margin-top: 3
    minimum: 0
    maximum: 100