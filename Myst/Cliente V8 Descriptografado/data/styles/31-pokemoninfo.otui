PokemonInfoLife < UIProgressBar
  height: 9
  background-color: #ec0000
  image-source: /images/ui/progressbar
  image-border: 1
  font: verdana-11px-rounded
  text-offset: 0 2

PokemonInfoExperience < UIProgressBar
  height: 9
  background-color: #029de6
  image-source: /images/ui/progressbar
  image-border: 1
  font: verdana-11px-rounded
  text-offset: 0 2

PokemonInfo < UIMiniWindow
  font: verdana-11px-antialised
  icon-rect: 4 4 16 16
  text-offset: 24 5
  text-align: topLeft
  image-source: /images/ui/miniwindow
  image-border: 4
  image-border-top: 23
  image-border-bottom: 4
  focusable: false
  &minimizedHeight: 24

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 3
    size: 258 18
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    margin-right: 5
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 24 0 14 14

    $hover:
      image-clip: 24 14 14 14

    $pressed:
      image-clip: 24 12 14 14

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: -1 0 14 14

    $hover:
      image-clip: -1 14 14 14

    $pressed:
      image-clip: -1 28 14 14

    $on:
      image-clip: 12 0 14 14

    $on hover:
      image-clip: 12 14 14 14

    $on pressed:
      image-clip: 12 28 14 14

  UIButton
    id: lockButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 74 0 14 14

    $hover:
      image-clip: 74 14 14 14

    $pressed:
      image-clip: 74 28 14 14

    $on:
      image-clip: 86 0 14 14

    $on hover:
      image-clip: 86 29 14 14

    $on pressed:
      image-clip: 86 28 14 14

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 22
    margin-right: 3
    margin-bottom: 3
    pixels-scroll: true
    visible: false

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 48
    margin-left: 3
    margin-right: 3
    background: #ffffff88

MiniWindowContents < ScrollablePanel
  id: contentsPanel
  anchors.fill: parent
  anchors.right: miniwindowScrollBar.left
  margin-left: 3
  margin-bottom: 3
  margin-top: 22
  margin-right: 1
  vertical-scrollbar: miniwindowScrollBar

BorderlessGameWindow < UIWindow
  focusable: false
  margin: 2
