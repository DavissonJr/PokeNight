TextEdit < UITextEdit
  font: verdana-11px-antialised
  color: black
  size: 86 20
  text-offset: 0 3
  padding: 3
  image-source: /images/ui/textedit
  image-border: 6
  image-border-top: 6
  image-border-bottom: 6
  selection-color: #111416
  selection-background-color: #999999
  $disabled:
    color: #aaaaaa88

AccountEdit < UITextEdit
  font: verdana-11px-antialised
  color: #aaaaaa
  size: 86 20
  text-offset: 0 3
  padding: 3
  image-border: 2
  image-border-top: 3
  image-border-bottom: 3
  selection-color: #111416
  selection-background-color: #999999
  $disabled:
    color: #aaaaaa88

PasswordEdit < UITextEdit
  font: verdana-11px-antialised
  color: #aaaaaa
  size: 86 20
  text-offset: 0 3
  padding: 3
  image-border: 2
  image-border-top: 3
  image-border-bottom: 3
  selection-color: #111416
  selection-background-color: #999999
  text-hidden: true
  $disabled:
    color: #aaaaaa88

PasswordTextEdit < UITextEdit
  font: verdana-11px-antialised
  color: black
  size: 86 20
  text-offset: 0 3
  padding: 5 6
  image-source: /images/ui/textedit
  image-border: 6
  image-border-top: 6
  image-border-bottom: 6
  selection-color: #111416
  selection-background-color: #999999
  text-hidden: true
  $disabled:
    color: #aaaaaa88

MultilineTextEdit < TextEdit
  multiline: true
